{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@sdk": ["../pi-sdk/src/types.ts"],
      "@contract": ["../contract/src/index.ts"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.vue",
    "src/preload/index.d.ts",
    "src/preload/api/**/*.ts",
    "src/lib/**/*.ts",
    "../pi-sdk/src/types.ts",
    "../contract/src/**/*.ts"
  ]
}
