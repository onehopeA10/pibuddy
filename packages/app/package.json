{
  "name": "@pibuddy/app",
  "version": "0.1.0",
  "private": true,
  "description": "PiBuddy - 你的 AI 办公小助手（基于 pi 智能体）",
  "author": "PiBuddy",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "prepare:runtime": "node scripts/prepare-pi-runtime.mjs",
    "check-update-deps": "node scripts/check-update-deps.mjs",
    "check-updater-capability": "node scripts/check-updater-capability.mjs",
    "dist": "node scripts/prepare-pi-runtime.mjs && electron-vite build && node scripts/build-config.mjs --exec -- electron-builder",
    "verify:artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:packaged": "node scripts/verify-packaged-app.mjs",
    "check-pure-js-deps": "node scripts/check-pure-js-deps.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@pibuddy/contract": "workspace:*",
    "@pibuddy/pi-sdk": "workspace:*",
    "codemirror": "6.0.2",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "fast-xml-parser": "4.5.3",
    "highlight.js": "^11.10.0",
    "jszip": "3.10.1",
    "mammoth": "1.12.0",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.42.0",
    "papaparse": "5.5.4",
    "pinia": "^3.0.0",
    "unpdf": "1.8.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/papaparse": "5.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
