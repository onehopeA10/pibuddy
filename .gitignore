# 依赖
node_modules/

# 构建产物
dist/
out/
release/
*.tsbuildinfo

# 参考材料（只读，不属于 PiBuddy 代码，体积原因排除）
source/

# 运行时下载物
packages/app/resources/pi-runtime/

# 日志与临时文件
*.log
.workflow/scratch/*/outputs/tmp*
.workflow/embedding*
.workflow/*.zvec
.workflow/search-cache.json
# 探查工具的中间产物：每次调用重新生成，留存无意义
.workflow/explore/
.workflow/search-daemon.json

# 系统
.DS_Store
Thumbs.db

# 本地 fake 更新源的开发期配置（packages/app/scripts/fake-update-server.mjs 生成）
dev-app-update.yml

# 本地调试用的 Chrome / Electron user-data 目录（CDP 取证时生成）
.devdata/
.devdata-chrome/
.ace-tool/
